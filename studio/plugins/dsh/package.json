{
  "name": "@robomaster/studio-dsh",
  "version": "0.2.0",
  "description": "RoboMaster CAD workflow, structured specifications, reusable skills and SolidWorks tools for DeepSeek Harness.",
  "private": true,
  "type": "module",
  "exports": { ".": "./index.js", "./client": "./client.js", "./locale/*.json": "./locale/*.json", "./icon": "./icon.svg" },
  "files": ["index.js", "service.js", "mcp.js", "workflow.json", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "immediately": true, "inject": ["@deepseek-ai/dsh-client-ui-conversation", "@deepseek-ai/dsh-client-ui-commands"], "external": ["react"] }
  }
}
